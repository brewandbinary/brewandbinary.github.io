---
import { getCollection } from 'astro:content';

const categoryDetails = {
  ai: { name: 'AI', description: 'Practical AI tools, agents, and ideas for people building and testing software.' },
  qa: { name: 'QA', description: 'Better testing practices, sharper test cases, and dependable software quality.' },
  automation: { name: 'Automation', description: 'Frameworks, pipelines, and workflows that make testing more reliable.' },
  development: { name: 'Development', description: 'JavaScript, coding techniques, and useful developer knowledge.' },
  'tech-news': { name: 'Tech News', description: 'A considered look at the technology updates worth your attention.' },
};
const slugs = Object.keys(categoryDetails);
export function getStaticPaths() {
  const categories = [
    'ai',
    'qa',
    'automation',
    'development',
    'tech-news'
  ];

  return categories.map((category) => ({
    params: { category }
  }));
}
const siteOrigin = Astro.site ?? new URL('https://brewandbinary.github.io/');
const slug = Astro.params.category;
const current = categoryDetails[slug];
const seoTitle = `${current.name} Articles | Brew & Binary`;
const seoDescription = `${current.name} articles from Brew & Binary. ${current.description}`;
const canonicalURL = new URL(`/categories/${slug}/`, siteOrigin).href;
const socialImage = new URL('/images/featured-ai-agents.jpg', siteOrigin).href;
const published = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((post) => (post.data.category ?? '').trim().toLowerCase() === current.name.toLowerCase())
  .sort((a, b) => new Date(b.data.pubDate ?? b.data.date ?? 0).getTime() - new Date(a.data.pubDate ?? a.data.date ?? 0).getTime());
const dateLabel = (value) => value ? new Date(value).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric', timeZone: 'UTC' }) : '';
const nav = [{ name: 'Articles', href: '/#articles' }, ...slugs.map((key) => ({ name: categoryDetails[key].name, href: `/categories/${key}/` }))];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={seoDescription} />
  <title>{seoTitle}</title>
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Brew & Binary" />
  <meta property="og:title" content={seoTitle} />
  <meta property="og:description" content={seoDescription} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:image:alt" content="Brew & Binary technology publication" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={seoTitle} />
  <meta name="twitter:description" content={seoDescription} />
  <meta name="twitter:image" content={socialImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/" aria-label="Brew and Binary home">brew <span>&amp;</span> binary<span class="dot">.</span></a>
      <nav class="desktop-nav" aria-label="Main navigation">
        {nav.map((item) => <a href={item.href} class:list={{active: item.name === current.name}} aria-current={item.name === current.name ? 'page' : undefined}>{item.name}</a>)}
      </nav>
      <div class="header-actions"><a class="subscribe" href="/#newsletter">Subscribe</a><button class="menu-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="mobile-nav">☰</button></div>
    </div>
    <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>{nav.map((item) => <a href={item.href} class:list={{active: item.name === current.name}}>{item.name}</a>)}</nav>
  </header>
  <main class="wrap">
    <div class="intro">
      <a class="back" href="/">← Back to home</a>
      <span class="eyebrow">EXPLORE THE JOURNAL</span>
      <h1>{current.name}<span class="dot">.</span></h1>
      <p>{current.description}</p>
      <div class="intro-bottom"><span class="accent-rule"></span><span>{published.length} {published.length === 1 ? 'article' : 'articles'}</span></div>
    </div>
    {published.length > 0 ? (
      <section class="article-grid" aria-label={`${current.name} articles`}>
        {published.map((post) => (
          <article class="article-card">
            <a href={`/articles/${post.id}/`} class="thumb"><img src={post.data.image ?? post.data.cover ?? '/images/weekly-tech-news.jpg'} alt={post.data.title} loading="lazy" /></a>
            <div class="card-body"><span class="pill">{current.name}</span><h2><a href={`/articles/${post.id}/`}>{post.data.title}</a></h2><p class="description">{post.data.description ?? ''}</p><p class="meta">{dateLabel(post.data.pubDate ?? post.data.date)} <span>·</span> {post.data.readingTime ?? post.data.readTime ?? post.data.read ?? 'Article'}</p></div>
          </article>
        ))}
      </section>
    ) : (
      <section class="empty"><h2>Something good is brewing.</h2><p>We haven't published a {current.name} article yet. Explore our other stories while we prepare the next one.</p><a href="/#articles">Browse all articles →</a></section>
    )}
  </main>
  <footer><div class="wrap footer-inner"><a class="brand" href="/">brew <span>&amp;</span> binary<span class="dot">.</span></a><p>Fresh tech, AI &amp; code — brewed weekly.</p><small>© {new Date().getFullYear()} Brew &amp; Binary. Made with curiosity.</small></div></footer>
  <script>
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const mobile = document.querySelector<HTMLElement>('#mobile-nav');
    toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(open)); if (mobile) mobile.hidden = !open; });
  </script>
</body>
</html>
<style>
  :global(*){box-sizing:border-box}:global(body){margin:0;background:#faf7f2;color:#192126;font-family:'DM Sans',Arial,sans-serif}:global(a){color:inherit;text-decoration:none}:global([hidden]){display:none!important}
  .wrap{width:min(1280px,calc(100% - 96px));margin-inline:auto}.site-header{border-bottom:1px solid #e7ddd2;background:rgba(250,247,242,.96);position:sticky;top:0;z-index:10;backdrop-filter:blur(12px)}.header-inner{width:min(1360px,calc(100% - 80px));margin:auto;min-height:74px;display:flex;align-items:center;justify-content:space-between;gap:28px}.brand{font-family:'Playfair Display',Georgia,serif;font-weight:800;font-size:30px;white-space:nowrap;letter-spacing:-1.6px}.brand span,.brand .dot,.dot{color:#ad6125}.desktop-nav{display:flex;align-items:center;gap:31px}.desktop-nav a{font-size:14px;font-weight:600;padding:27px 0 24px;border-bottom:3px solid transparent;white-space:nowrap}.desktop-nav a.active,.desktop-nav a:hover{border-color:#b46a2c}.header-actions{display:flex;align-items:center;gap:24px}.subscribe{background:#ae611e;color:#fff;border-radius:8px;padding:12px 21px;font-weight:700;font-size:14px}.subscribe:hover{background:#874815}.menu-toggle{display:none;border:0;background:transparent;font-size:24px;cursor:pointer}.mobile-nav{padding:14px 30px;border-top:1px solid #e7ddd2}.mobile-nav a{display:block;padding:9px 0}.mobile-nav .active{color:#ae611e;font-weight:700}
  .intro{padding:52px 0 32px;border-bottom:1px solid #e4d9ce;margin-bottom:30px}.back{display:block;font-size:13px;color:#a65b24;font-weight:700;margin-bottom:28px}.eyebrow{display:inline-block;border:1px solid #e0b28a;background:#fbede1;border-radius:20px;padding:6px 14px;font-weight:700;font-size:12px;letter-spacing:1.3px}.intro h1{font-family:'Playfair Display',Georgia,serif;font-size:clamp(52px,6vw,85px);line-height:1.1;letter-spacing:-3px;margin:16px 0 12px}.intro>p{font-size:18px;line-height:1.65;color:#5c5a57;max-width:710px}.intro-bottom{display:flex;align-items:center;gap:15px;font-size:12px;color:#75675c;font-weight:600;margin-top:24px}.accent-rule{width:58px;height:3px;background:#b2682d}.article-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;padding:0 0 80px}.article-card{min-width:0}.thumb{display:block;overflow:hidden;border-radius:10px}.thumb img{display:block;width:100%;height:205px;object-fit:cover;transition:transform .25s ease}.article-card:hover img{transform:scale(1.025)}.card-body{padding-top:15px}.pill{background:#f4dfcb;border-radius:20px;padding:5px 12px;font-size:12px;font-weight:700;display:inline-block}.article-card h2{font-family:'Playfair Display',Georgia,serif;font-size:25px;line-height:1.25;letter-spacing:-.4px;margin:13px 0 9px}.article-card h2 a:hover{color:#ad6125}.description{font-size:14px;color:#5c5a57;line-height:1.65}.meta{font-size:12px;color:#66615c;margin-top:16px}.meta span{padding:0 7px}.empty{padding:55px 20px 95px;text-align:center}.empty h2{font-family:'Playfair Display',Georgia,serif;font-size:34px}.empty p{color:#5c5a57;line-height:1.6}.empty a{color:#a65b24;font-weight:700}footer{background:#1b282a;color:#eee6db;padding:35px 0}.footer-inner{display:flex;align-items:center;justify-content:space-between;gap:20px}.footer-inner .brand{font-size:24px}.footer-inner p,.footer-inner small{font-size:12px;color:#c4c7c1}
  @media(max-width:1120px){.desktop-nav{gap:17px}.desktop-nav a{font-size:12px}.brand{font-size:25px}.header-actions{gap:12px}.article-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:850px){.desktop-nav{display:none}.menu-toggle{display:block}.header-inner{width:calc(100% - 40px)}.wrap{width:calc(100% - 40px)}}@media(max-width:600px){.brand{font-size:23px}.header-inner{min-height:66px}.subscribe{padding:10px 12px;font-size:12px}.intro{padding-top:32px}.intro h1{font-size:52px}.article-grid{grid-template-columns:1fr}.thumb img{height:215px}.footer-inner{flex-direction:column;text-align:center}}
</style>
