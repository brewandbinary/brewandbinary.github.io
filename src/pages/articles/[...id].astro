---
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({data}) => !data.draft);
  return posts.map(post => ({params:{id:post.id}, props:{post}}));
}
const {post} = Astro.props;
const {Content} = await render(post);
const all = await getCollection('blog', ({data}) => !data.draft);
const related = all.filter(p => p.id !== post.id).sort((a,b) => Number(b.data.category === post.data.category)-Number(a.data.category === post.data.category)).slice(0,3);
const date = post.data.pubDate.toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'});
const categories = ['Articles','AI','QA','Automation','Development','Tech News'];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="description" content={post.data.description}/><title>{post.data.title} | Brew & Binary</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700;800&display=swap" rel="stylesheet"/>
</head>
<body>
<div id="reading-progress" aria-hidden="true"></div>
<header class="site-header"><div class="header-inner">
<a class="brand" href="/">brew <span>&amp;</span> binary<span>.</span></a>
<nav aria-label="Main navigation">{categories.map(c => <a href="/#articles">{c}</a>)}</nav>
<a class="subscribe" href="/#newsletter">Subscribe</a>
</div></header>
<main>
<a class="back" href="/#articles">← Back to articles</a>
<article id="article-content">
<div class="eyebrow">{post.data.category}</div>
<h1>{post.data.title}</h1>
<p class="description">{post.data.description}</p>
<div class="meta"><span>By {post.data.author}</span><span class="separator">·</span><time datetime={post.data.pubDate.toISOString()}>{date}</time></div>
{post.data.image && <img class="cover" src={post.data.image} alt={`Illustration for ${post.data.title}`}/>}
<div class="prose"><Content/></div>
</article>
<section class="endnote"><div class="eyebrow">THE EDITOR'S NOTE</div><h2>Curiosity is always in season.</h2><p>Thanks for reading Brew &amp; Binary. More thoughtful tech, AI and code stories are brewing.</p><a href="/#articles">← Explore more articles</a></section>
{related.length > 0 && <section class="related"><div class="section-heading"><h2>Keep reading</h2><span></span></div><div class="related-grid">{related.map(p => <a class="related-card" href={`/articles/${p.id}/`}>{p.data.image && <img src={p.data.image} alt="" loading="lazy"/>}<small>{p.data.category}</small><h3>{p.data.title}</h3></a>)}</div></section>}
</main>
<footer><div class="footer-inner"><a class="brand" href="/">brew <span>&amp;</span> binary<span>.</span></a><p>Fresh tech, AI &amp; code — brewed weekly.</p><small>© {new Date().getFullYear()} Brew &amp; Binary</small></div></footer>
<script>
const bar = document.querySelector<HTMLElement>('#reading-progress');
const article = document.querySelector<HTMLElement>('#article-content');
function updateProgress(){if(!bar || !article)return;const start=article.getBoundingClientRect().top+window.scrollY;const end=start+article.offsetHeight-window.innerHeight;const fraction=end<=start ? 1 : Math.min(1,Math.max(0,(window.scrollY-start)/(end-start)));bar.style.width=`${fraction*100}%`;}
window.addEventListener('scroll',updateProgress,{passive:true});window.addEventListener('resize',updateProgress);updateProgress();
document.querySelectorAll<HTMLElement>('.prose pre').forEach(pre=>{
  const button=document.createElement('button');button.type='button';button.className='copy-code';button.textContent='Copy code';button.setAttribute('aria-label','Copy code snippet');
  pre.appendChild(button);
  button.addEventListener('click',async()=>{const code=pre.querySelector('code')?.textContent || '';try{await navigator.clipboard.writeText(code);button.textContent='Copied!';setTimeout(()=>button.textContent='Copy code',1800);}catch{button.textContent='Select code to copy';}});
});
</script>
</body></html>
<style is:global>
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#faf7f2;color:#192126;font-family:'DM Sans',Arial,sans-serif}a{color:inherit;text-decoration:none}#reading-progress{position:fixed;top:0;left:0;height:3px;width:0;background:#b56320;z-index:100}.site-header{position:sticky;top:0;z-index:20;background:rgba(250,247,242,.97);border-bottom:1px solid #e7ddd2;backdrop-filter:blur(10px)}.header-inner{max-width:1360px;min-height:74px;padding:0 32px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:26px}.brand{font-family:'Playfair Display',Georgia,serif;font-size:29px;font-weight:800;letter-spacing:-1.5px;white-space:nowrap}.brand span{color:#ad6125}.header-inner nav{display:flex;align-items:center;gap:28px}.header-inner nav a{font-size:14px;font-weight:600;white-space:nowrap}.header-inner nav a:hover,.back:hover,.endnote a:hover{color:#ad6125}.subscribe{background:#ae611e;color:white;border-radius:8px;padding:12px 22px;font-weight:700;font-size:14px}.subscribe:hover{background:#874815}main{max-width:860px;margin:52px auto 90px;padding:0 28px}.back{font-size:13px;font-weight:700;color:#a65b24}.eyebrow{display:inline-block;background:#f7e5d5;border:1px solid #e6b994;border-radius:30px;color:#92501e;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;padding:7px 14px}article .eyebrow{margin-top:36px}h1,h2,h3{font-family:'Playfair Display',Georgia,serif}h1{font-size:clamp(39px,5vw,62px);line-height:1.15;letter-spacing:-1.5px;margin:20px 0 18px}.description{font-size:20px;line-height:1.65;color:#606365;margin:0 0 15px}.meta{display:flex;gap:12px;font-size:13px;color:#77716c;padding:16px 0 28px;border-bottom:1px solid #e5d9ce}.separator{color:#b56320}.cover{width:100%;max-height:430px;object-fit:cover;border-radius:12px;display:block;margin:30px 0 38px}.prose{font-size:18px;line-height:1.85}.prose h2{font-size:31px;line-height:1.3;margin:42px 0 13px}.prose h3{font-size:24px;line-height:1.35;margin:30px 0 10px}.prose p,.prose ul,.prose ol{margin:0 0 23px}.prose a{color:#a65b24;text-decoration:underline}.prose pre{position:relative;background:#20272b!important;border-radius:11px;padding:46px 22px 22px;overflow-x:auto;font-size:14px;line-height:1.65}.prose pre code{font-family:Consolas,'Courier New',monospace}.prose :not(pre)>code{background:#eee4d9;padding:3px 6px;border-radius:4px;font-size:.87em}.copy-code{position:absolute;top:10px;right:12px;border:1px solid #526064;background:#313c40;color:#f3e7d8;padding:5px 10px;border-radius:5px;font:12px 'DM Sans',sans-serif;cursor:pointer}.copy-code:hover{background:#48595d}.endnote{border-top:1px solid #e4d8cc;margin-top:65px;padding-top:35px}.endnote h2{font-size:30px;margin:16px 0 10px}.endnote p{line-height:1.7;color:#626262}.endnote a{display:inline-block;color:#a65b24;font-weight:700;font-size:14px;margin-top:10px}.related{margin-top:65px}.section-heading h2{font-size:34px;margin:0 0 9px}.section-heading span{display:block;width:55px;height:3px;background:#b56320;margin-bottom:25px}.related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.related-card img{width:100%;height:120px;object-fit:cover;border-radius:9px}.related-card small{display:inline-block;color:#a65b24;margin-top:10px;font-weight:700}.related-card h3{font-size:18px;line-height:1.3;margin:7px 0}.related-card:hover h3{color:#a65b24}footer{background:#1b282a;color:#eee6db;padding:34px 0}.footer-inner{max-width:1360px;margin:auto;padding:0 32px;display:flex;justify-content:space-between;align-items:center;gap:20px}.footer-inner .brand{font-size:24px}.footer-inner p,.footer-inner small{font-size:12px;color:#c4c7c1}@media(max-width:1100px){.header-inner nav{gap:13px}.header-inner nav a{font-size:12px}}@media(max-width:850px){.header-inner nav{display:none}.header-inner{padding:0 20px}.brand{font-size:23px}.subscribe{padding:10px 13px}.related-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){main{margin-top:30px}.description{font-size:17px}.prose{font-size:16px}.prose h2{font-size:25px}.related-grid{grid-template-columns:1fr}.footer-inner{flex-direction:column;text-align:center}}
</style>
